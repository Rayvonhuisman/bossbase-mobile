# =============================================================================
# .easignore — wat NIET mee de EAS-upload in gaat
# =============================================================================
#
# Let op de val in dit bestand: zodra er een `.easignore` bestaat, gebruikt EAS
# ÚITSLUITEND dit bestand en kijkt het niet meer naar `.gitignore`. Alles wat
# daar buiten moet blijven — .env, sleutels, certificaten, caches, node_modules
# — moet hier dus opnieuw staan, anders reist het alsnog mee naar de
# buildserver. Daarom is de inhoud van `.gitignore` hieronder integraal
# overgenomen; onderaan staat alleen wat er specifiek voor EAS bij komt.
#
# Bijwerken doe je aan beide kanten, of je haalt dit bestand weg en laat EAS
# weer op `.gitignore` terugvallen.
# =============================================================================

# ── Integraal overgenomen uit .gitignore ────────────────────────────────────
node_modules/
.expo/
dist/
web-build/
*.tsbuildinfo
expo-env.d.ts

# Native
ios/
android/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Env
.env
.env.local
.env.*.local

# OS
.DS_Store
Thumbs.db

# Editor
.idea/
.vscode/
*.swp

# Logs
npm-debug.*
yarn-debug.*
yarn-error.*

# ── Aangescherpt vóór de baselinecommit (2026-09-11) ────────────────────────
# Alle env-varianten, behalve het voorbeeldbestand met placeholderwaarden.
.env.*
!.env.example

# Native build- en afhankelijkheidsmappen (ios/ en android/ staan hierboven al
# volledig uit; deze regels vangen ze ook als die ooit worden getrackt).
ios/Pods/
ios/build/
android/build/
android/app/build/
.gradle/
DerivedData/
build/

# Sleutels, certificaten en provisioning
*.pem
*.cer
*.certSigningRequest
*.provisionprofile
credentials.json
google-services.json
GoogleService-Info.plist
.secrets
secrets.json

# Logs en caches
*.log
.cache/
.tmp/

# ── Alleen voor de EAS-upload ───────────────────────────────────────────────
# Ontwerpmateriaal: schermafdrukken van vóór en na het herontwerp plus de
# icoonpreview. Bij elkaar zo'n 50 MB, en de build doet er niets mee — de app
# laadt geen enkel bestand uit deze map. Hij staat bewust niet in .gitignore,
# want lokaal en in de repo mag hij gewoon bestaan.
design-reference/

# Interne documentatie en servervoorstellen: alleen voor mensen, niet voor de
# bundel.
MOBILE_*.md
MOBILE_*.sql
